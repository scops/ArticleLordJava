# Required
ANTHROPIC_API_KEY=your_anthropic_api_key
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM=your_email@domain.com

# LLM Model for summarization (use latest stable model)
LLM_MODEL=claude-sonnet-5-5
# Reasoning effort: low | medium | high | xhigh | max (leave empty for Haiku 4.5)
LLM_EFFORT=medium
# Retry on another model if the request is declined (only Sonnet 5.5 / Opus 5.x / Fable 5.1)
LLM_FALLBACKS=true

# Playwright MCP browser mode (true for Docker / servers without display)
PLAYWRIGHT_HEADLESS=false

# Optional Playwright MCP overrides (default: npx -y @playwright/mcp@latest)
# PLAYWRIGHT_MCP_COMMAND=/path/to/npx -y @playwright/mcp@latest
# PLAYWRIGHT_MCP_ARGS=--browser chromium
